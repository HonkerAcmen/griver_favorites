# ==========================================
# PostgreSQL
# ==========================================
# 应用异步连接（FastAPI / SQLAlchemy async）
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/griver_favorites
# Alembic / psql 同步连接
DATABASE_URL_SYNC=postgresql+psycopg://postgres:password@localhost:5432/griver_favorites

# ==========================================
# Redis（Cache-Aside：收藏夹详情 + item_count）
# ==========================================
REDIS_READ_URL=redis://localhost:6379/0
REDIS_WRITE_URL=redis://localhost:6379/0

# ==========================================
# RabbitMQ（收藏成功后异步操作日志）
# ==========================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
FAVORITE_EVENT_EXCHANGE=favorite.events
FAVORITE_EVENT_ROUTING_KEY=favorite.item.added
FAVORITE_OPERATION_LOG_QUEUE=favorite.operation_log
FAVORITE_OPERATION_LOG_DLQ=favorite.operation_log.dlq
